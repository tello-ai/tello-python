{
  "version": "1.0",
  "frame": {
    "description": "Flat error frame sent by turn-provider-gateway /sdk (not wrapped in an {error:{...}} envelope).",
    "fields": {
      "type": "error",
      "version": "1.0",
      "code": "string",
      "message": "string",
      "requestId": "string (optional, echoes the client's requestId on the failed command)",
      "question": "string (optional, present for callRejected)"
    }
  },
  "errors": [
    { "code": "unauthenticated", "message": "Authentication required", "closeCode": 4401, "sdkException": "AuthenticationError" },
    { "code": "callAlreadyActive", "message": "A call is already active", "sdkException": "CallAlreadyActiveError" },
    { "code": "toRequired", "message": "to is required", "sdkException": "ValidationError" },
    { "code": "agentIdRequired", "message": "agentId is required", "sdkException": "ValidationError" },
    { "code": "noActiveCall", "message": "No active call", "sdkException": "NoActiveCallError" },
    { "code": "callRejected", "message": "Call rejected", "sdkException": "CallRejectedError", "extra": ["question"] },
    { "code": "internalError", "message": "Internal error", "sdkException": "TelloServerError" }
  ]
}
